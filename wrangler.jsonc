{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ccat-cats-api",
  "main": "worker.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "CCAT_CATS",
      "id": "4815d0f93a004d97a80142bfdf481987"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CCAT_STORE",
        "class_name": "CcatStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CcatStore"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
